{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["jest", "react-native", "node"],
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "exclude": ["supabase/functions", "node_modules"],
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
